-- 3.2 DQL - Consultas de negocio
 
-- 1) Busca Multipla: paciente, data da consulta, medico e especialidade
--    apenas para consultas realizadas no ano atual.

SELECT
    p.nome            AS 'Paciente',
    c.dataconsulta    AS 'Data da Consulta',
    m.nome            AS 'Médico',
    e.nome            AS 'Especialidade'
FROM consulta c
JOIN paciente p        ON p.idpaciente = c.idpaciente
JOIN medico m          ON m.idmedico   = c.idmedico
JOIN especialidades e  ON e.idespecialidade = m.idespecialidade
WHERE YEAR(c.dataconsulta) = YEAR(CURDATE());
 
 -- 2) Agregacao: total de receita por especialidade, da maior para a menor.

SELECT
    e.nome AS Especialidade,
    SUM(pg.valor) AS Total_Receita
FROM pagamento pg
JOIN consulta c        ON c.idconsulta = pg.idconsulta
JOIN medico m          ON m.idmedico   = c.idmedico
JOIN especialidades e  ON e.idespecialidade = m.idespecialidade
GROUP BY e.nome
ORDER BY Total_Receita DESC;

-- 3) Left Join: todos os medicos e, quando houver, a data da consulta.
--    Medicos sem consultas tambem aparecem na lista.

SELECT
    m.nome AS 'Médico',
    c.dataconsulta AS 'Data da Consulta'
FROM medico m
LEFT JOIN consulta c ON c.idmedico = m.idmedico;


-- FASE 4: PROGRAMACAO DE BANCO DE DADOS (VIEWS E TRIGGERS)


-- 4.1 View de Prontuario: une paciente, consultas e exames.

CREATE OR REPLACE VIEW vw_historico_paciente AS
SELECT
    p.idpaciente,
    p.nome              AS nome_paciente,
    c.idconsulta,
    c.dataconsulta,
    c.status            AS status_consulta,
    c.observacoes        AS observacoes_consulta,
    m.nome              AS nome_medico,
    ex.idexame,
    ex.tipo             AS tipo_exame,
    ex.resultado        AS resultado_exame,
    ex.dataexame
FROM paciente p
LEFT JOIN consulta c ON c.idpaciente = p.idpaciente
LEFT JOIN medico m   ON m.idmedico   = c.idmedico
LEFT JOIN exame ex   ON ex.idpaciente = p.idpaciente;

-- 4.2 Tabela de Auditoria + Trigger
--     Registra alteracoes no campo sensivel "anotacoes_prontuario" da tabela
--     consulta, guardando o texto antigo, a data/hora e o ID da consulta.

CREATE TABLE log_auditoria_prontuario (
    idlog               INT AUTO_INCREMENT PRIMARY KEY,
    idconsulta           INT NOT NULL,
    texto_antigo         TEXT,
    data_hora_alteracao  DATETIME NOT NULL,
    CONSTRAINT fk_log_consulta
        FOREIGN KEY (idconsulta) REFERENCES consulta(idconsulta)
        ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB;

DELIMITER //

CREATE TRIGGER trg_auditoria_prontuario
AFTER UPDATE ON consulta
FOR EACH ROW
BEGIN
    IF (NOT (OLD.anotacoes_prontuario <=> NEW.anotacoes_prontuario)) THEN
        INSERT INTO log_auditoria_prontuario (idconsulta, texto_antigo, data_hora_alteracao)
        VALUES (OLD.idconsulta, OLD.anotacoes_prontuario, NOW());
    END IF;
END;
//

DELIMITER ;


